---
import Layout from "../layouts/Layout.astro";
import MasonryGrid from "../components/MasonryGrid.astro";
import { getCollection } from "astro:content";

const settingsEntries = await getCollection("settings");
const portfolioEntries = await getCollection("portfolio");

const settings = settingsEntries[0]?.data;
const portfolio = portfolioEntries[0]?.data;
const email = settings?.email ?? "";
const about = settings?.about?.trim() ?? "";
---

<Layout
    name={settings?.name ?? "June Lee"}
    email={settings?.email ?? ""}
    tagline={settings?.tagline ?? ""}
>
    <main class="mx-auto max-w-[1600px] px-gutter pt-4 pb-24">
        {
            portfolio?.sections && portfolio.sections.length > 0 ? (
                <MasonryGrid sections={portfolio.sections} email={email} />
            ) : (
                <p class="text-muted">No work to show yet.</p>
            )
        }
    </main>

    {
        about && (
            <footer class="mx-auto max-w-[1600px] px-gutter pb-24">
                <p
                    class="max-w-prose text-sm leading-relaxed text-muted"
                    data-dk="about"
                >
                    {about}
                </p>
            </footer>
        )
    }
</Layout>

<script src="../scripts/lightbox.ts"></script>
