---
import Layout from "../layouts/Layout.astro";
import Portfolio from "../components/Portfolio.astro";
import { getCollection } from "astro:content";

const settingsEntries = await getCollection("settings");
const portfolioEntries = await getCollection("portfolio");

const settings = settingsEntries[0]?.data;
const portfolio = portfolioEntries[0]?.data;
const about = settings?.about?.trim() ?? "";
---

<Layout
    name={settings?.name ?? "June Lee"}
    email={settings?.email ?? ""}
    tagline={settings?.tagline ?? ""}
>
    <main>
        {
            portfolio?.sections && portfolio.sections.length > 0 ? (
                <Portfolio sections={portfolio.sections} />
            ) : (
                <p>No work to show yet.</p>
            )
        }
    </main>

    {about && <footer><p>{about}</p></footer>}
</Layout>
