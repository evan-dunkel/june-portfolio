---
interface Props {
    /** The value copied to the clipboard, also shown as the label. */
    value: string;
    /** Optional DialKit target id, emitted as `data-dk`. */
    dk?: string;
    class?: string;
}

const { value, dk, class: className = "" } = Astro.props;
---

<button
    type="button"
    class:list={[
        "copy-btn group relative flex items-center gap-1.5 rounded-sm py-0.5 text-sm text-muted transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground",
        className,
    ]}
    aria-label={`Copy email address: ${value}`}
    data-copy-trigger
    data-copy-value={value}
    data-dk={dk}
>
    <span class="select-text" data-copy-label>{value}</span>
    <!-- Icon container -->
    <span
        class="relative flex h-4 w-4 shrink-0 items-center justify-center"
    >
        <!-- Copy icon -->
        <svg
            class="copy-icon absolute h-4 w-4 transition-all duration-200 ease-out-soft"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path
                d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
        </svg>
        <!-- Check icon -->
        <svg
            class="check-icon absolute h-4 w-4 transition-all duration-400 ease-spring"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </span>
</button>

<style>
    .copy-btn .check-icon {
        opacity: 0;
        transform: scale(0) rotate(-90deg);
    }

    .copy-btn .copy-icon {
        opacity: 1;
        transform: scale(1);
    }

    .copy-btn[data-copied] .copy-icon {
        opacity: 0;
        transform: scale(0.5);
    }

    .copy-btn[data-copied] .check-icon {
        opacity: 1;
        transform: scale(1) rotate(0deg);
    }

    /* Press feedback — instant on touch-down */
    .copy-btn:active {
        transform: scale(0.97);
    }

    @media (prefers-reduced-motion: reduce) {
        .copy-btn .copy-icon,
        .copy-btn .check-icon {
            transition-duration: 0s;
        }
        .copy-btn:active {
            transform: none;
        }
    }
</style>

<script>
    import { bindCopyButton } from "../scripts/copy-to-clipboard";

    document
        .querySelectorAll<HTMLButtonElement>("[data-copy-trigger]")
        .forEach((el) => bindCopyButton(el, el.dataset.copyValue ?? ""));
</script>
