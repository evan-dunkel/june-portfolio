---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";

type Section = CollectionEntry<"portfolio">["data"]["sections"][number];

interface Props {
    sections: Section[];
}

const { sections } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/works/**/*.{svg,jpg,jpeg,png,webp,gif}",
    { eager: true },
);

// Match CMS paths on both case-sensitive and case-insensitive filesystems.
const images = new Map(
    Object.entries(imageModules).map(([path, module]) => [
        path.toLowerCase(),
        module.default,
    ]),
);
let imageIndex = 0;
---

{
    sections.map((section) => (
        <section>
            <h2>{section.title}</h2>
            {section.works.map((work) => {
                const image = images.get(work.src.toLowerCase());
                if (!image) {
                    console.warn(`[Portfolio] Could not resolve image src: "${work.src}"`);
                    return <p>{work.caption || work.alt}</p>;
                }

                // Animated artwork opens on demand instead of autoplaying.
                if (image.format === "gif") {
                    return <p><a href={image.src}>{work.caption || work.alt}</a></p>;
                }

                const isFirst = imageIndex++ === 0;
                return (
                    <figure>
                        <a href={image.src}>
                            <Image
                                src={image}
                                alt={work.alt}
                                width={Math.min(640, image.width)}
                                format="webp"
                                loading={isFirst ? "eager" : "lazy"}
                                fetchpriority={isFirst ? "high" : undefined}
                            />
                        </a>
                        {work.caption && <figcaption>{work.caption}</figcaption>}
                    </figure>
                );
            })}
        </section>
    ))
}
