---
import Header from "../components/Header.astro";
import DialKit from "../components/DialKit.astro";
import "../styles/global.css";

interface Props {
    name: string;
    email: string;
    tagline: string;
}

const { name, email, tagline } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>June Lee — Illustration</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="preload"
            href="/June-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body
        class="min-h-screen bg-background text-foreground antialiased"
        data-dk="body"
    >
        <Header name={name} email={email} tagline={tagline} />
        <slot />
        <DialKit />
    </body>
</html>
